from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
import os, glob
from datetime import datetime

app = FastAPI()

app.add_middleware(
    CORSMiddleware,
    allow_origins=['*'],
    allow_methods=['*'],
    allow_headers=['*'],
)

GLM_DIR = r'M:/GOES-R-GLM-Products'
DENS_DIR = GLM_DIR + '/DENS'
LCFA_DIR = GLM_DIR + '/LCFA'

RJ_LAT_MIN = -23.5
RJ_LAT_MAX = -21.5
RJ_LON_MIN = -44.5
RJ_LON_MAX = -41.5

def get_sorted_folders(base):
    folders = sorted(glob.glob(base + '/*/'), reverse=True)
    return folders

def find_latest_dens():
    files = sorted(glob.glob(GLM_DIR + '/GLM_DENS_*.nc'))
    if files:
        return files[-1]
    folders = get_sorted_folders(DENS_DIR)
    for folder in folders:
        subfolders = sorted(glob.glob(folder + '*/'), reverse=True)
        for sf in subfolders:
            files = sorted(glob.glob(sf + '*.nc'))
            if files:
                return files[-1]
    return None

@app.get('/api/status')
def status():
    folders = get_sorted_folders(LCFA_DIR)
    lcfa_f = None
    for folder in folders:
        files = sorted(glob.glob(folder + '*.nc'))
        if files:
            lcfa_f = files[-1]
            break
    dens_f = find_latest_dens()
    return {
        'ok': True,
        'time': str(datetime.now()),
        'dens': os.path.basename(dens_f) if dens_f else None,
        'lcfa': os.path.basename(lcfa_f) if lcfa_f else None,
    }

@app.get('/api/disk/recent')
def disk_recent(limit: int = 6):
    result = []
    folders = get_sorted_folders(LCFA_DIR)
    count = 0
    for folder in folders:
        if count >= 4:
            break
        files = sorted(glob.glob(folder + '*.nc'), key=os.path.getmtime, reverse=True)
        for f in files[:2]:
            if count >= 4:
                break
            size = os.path.getsize(f) / 1e6
            age_s = int((datetime.now().timestamp() - os.path.getmtime(f)))
            result.append({'name': os.path.basename(f), 'type': 'LCFA', 'size_mb': round(size,2), 'age': str(age_s//60)+'min', 'fresh': age_s < 700})
            count += 1
    dens_f = find_latest_dens()
    if dens_f:
        size = os.path.getsize(dens_f) / 1e6
        age_s = int((datetime.now().timestamp() - os.path.getmtime(dens_f)))
        result.append({'name': os.path.basename(dens_f), 'type': 'DENS', 'size_mb': round(size,2), 'age': str(age_s//60)+'min', 'fresh': age_s < 700})
    return {'files': result}

@app.get('/api/dens/grid')
def dens_grid(step: int = 3):
    try:
        import netCDF4 as nc
        import numpy as np
        f = find_latest_dens()
        if not f:
            return {'points': [], 'error': 'arquivo nao encontrado'}
        ds = nc.Dataset(f)
        lats = ds.variables['lat'][:]
        lons = ds.variables['lon'][:]
        event = ds.variables['event'][0]
        ds.close()
        points = []
        for i in range(0, len(lats), step):
            for j in range(0, len(lons), step):
                la = float(lats[i])
                lo = float(lons[j])
                if RJ_LAT_MIN <= la <= RJ_LAT_MAX and RJ_LON_MIN <= lo <= RJ_LON_MAX:
                    val = float(event[i, j])
                    if val > 0:
                        points.append({'lat': la, 'lon': lo, 'val': round(val, 2)})
        return {'points': points, 'file': os.path.basename(f)}
    except Exception as e:
        return {'points': [], 'error': str(e)}

@app.get('/api/lcfa/latest')
def lcfa_latest(max_points: int = 5000, folders_back: int = 5):
    try:
        import netCDF4 as nc
        import numpy as np
        folders = get_sorted_folders(LCFA_DIR)
        all_flashes = []
        flash_count_global = 0
        group_count_global = 0
        event_count_global = 0
        energy_list_rj = []
        area_list_rj = []
        latest_file = None
        for folder in folders[:folders_back]:
            files = sorted(glob.glob(folder + '*.nc'))
            for f in files:
                if latest_file is None:
                    latest_file = f
                try:
                    ds = nc.Dataset(f)
                    flash_lat = ds.variables['flash_lat'][:]
                    flash_lon = ds.variables['flash_lon'][:]
                    flash_energy = ds.variables['flash_energy'][:]
                    flash_area = ds.variables['flash_area'][:]
                    fc = ds.variables['flash_count'][:] if 'flash_count' in ds.variables else 0
                    gc = ds.variables['group_count'][:] if 'group_count' in ds.variables else 0
                    ec = ds.variables['event_count'][:] if 'event_count' in ds.variables else 0
                    flash_count_global += int(fc)
                    group_count_global += int(gc)
                    event_count_global += int(ec)
                    ds.close()
                    mask = ((flash_lat >= RJ_LAT_MIN) & (flash_lat <= RJ_LAT_MAX) &
                            (flash_lon >= RJ_LON_MIN) & (flash_lon <= RJ_LON_MAX))
                    rj_lats = flash_lat[mask]
                    rj_lons = flash_lon[mask]
                    rj_energy = flash_energy[mask]
                    rj_area = flash_area[mask]
                    for i in range(len(rj_lats)):
                        if len(all_flashes) >= max_points:
                            break
                        e_val = float(rj_energy[i]) if not np.ma.is_masked(rj_energy[i]) else 0
                        a_val = float(rj_area[i]) if not np.ma.is_masked(rj_area[i]) else 0
                        all_flashes.append({'lat': float(rj_lats[i]), 'lon': float(rj_lons[i]), 'energy': e_val, 'area': a_val})
                        energy_list_rj.append(e_val)
                        area_list_rj.append(a_val)
                except Exception:
                    pass
        metrics = {
            'flash_count_global': flash_count_global,
            'group_count_global': group_count_global,
            'event_count_global': event_count_global,
            'flash_count_rj': len(all_flashes),
            'energy_mean_rj': round(float(np.mean(energy_list_rj)), 8) if energy_list_rj else 0,
            'area_mean_rj': round(float(np.mean(area_list_rj)), 2) if area_list_rj else 0,
        }
        return {'flashes': all_flashes, 'metrics': metrics, 'file': os.path.basename(latest_file) if latest_file else None}
    except Exception as e:
        return {'flashes': [], 'metrics': {}, 'error': str(e)}

